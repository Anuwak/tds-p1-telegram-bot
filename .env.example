# Copy this file to .env and fill in the values.

# --- Telegram bot (from @BotFather) ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# --- LLM: AIPipe (recommended for TDS) ---
# Get the token at https://aipipe.org (log in with your IITM email).
LLM_BASE_URL=https://aipipe.org/openai/v1
LLM_API_KEY=your-aipipe-token
LLM_MODEL=gpt-4.1-mini

# --- Public log hosting via GitHub (raw URL) ---
# PAT with contents:write on the repo. Repo must be PUBLIC.
GITHUB_TOKEN=github_pat_xxx
GITHUB_REPO=your-username/tds-p1-telegram-bot
GITHUB_BRANCH=main
LOG_DIR_IN_REPO=logs

# --- Agent tuning (optional) ---
MAX_AGENT_STEPS=12
PYTHON_TIMEOUT=60
CHAT_DEBOUNCE_SECONDS=4
